# Application data and public API client settings. No real credentials belong here.
XQ_DATA_DIR=.data
PORT=4317
XQ_API_URL=http://127.0.0.1:4317
XQ_TOKEN_FILE=/absolute/private/path/application-token
# Use the actual region/workspace endpoint from your Alibaba Cloud console.
DASHSCOPE_BASE_URL=https://WORKSPACE.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_API_KEY=
# Exact hostnames only; no schemes, paths, query strings or wildcard suffixes.
XQ_AUDIO_HOSTS=
XQ_RESULT_HOSTS=

# Bounded job workers; supported range 1-4.
XQ_WORKER_CONCURRENCY=2
