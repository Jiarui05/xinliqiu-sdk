{
  "name": "@xinliqiu/backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "bootstrap": "tsx src/bootstrap.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "openapi:generate": "tsx scripts/openapi.ts",
    "client:generate": "pnpm openapi:generate && orval",
    "check": "pnpm typecheck && pnpm cli:build && pnpm test",
    "library:plan": "tsx scripts/plan-library.ts",
    "library:transcribe": "tsx scripts/transcribe-library.ts",
    "cli:build": "tsx scripts/build-cli.ts",
    "cloud:publish": "python3 scripts/publish-cloud.py"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.18",
    "@volcengine/tos-sdk": "^2.9.1",
    "ai": "^7.0.166",
    "commander": "^15.1.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "hono": "^4.13.17",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "orval": "^8.47.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
